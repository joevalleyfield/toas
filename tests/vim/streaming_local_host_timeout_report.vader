Before:
  set nocompatible
  set hidden
  source vim/plugin/toas.vim
  let g:toas_transport_mode = 'local_host'
  let g:toas_watch_first_frame_timeout_ms = 1000
  let g:toas_watch_inter_frame_timeout_ms = 1000
  let g:toas_timeout_report_calls = 0
  let g:toas_timeout_sid = ''
  for g:timeout_script_line in split(execute('scriptnames'), "\n")
    if g:timeout_script_line =~# 'vim/plugin/toas\.vim$'
      let g:toas_timeout_sid = '<SNR>' . matchstr(g:timeout_script_line, '^\s*\zs\d\+\ze:') . '_'
    endif
  endfor

  function! g:ToasTimeoutReportRequest(op, payload, timeout_s) abort
    if a:op ==# 'step_async'
      return {'ok': v:true, 'payload': {'run_id': 'rtimeoutreport1', 'status': 'running', 'stream_policy': {}}}
    endif
    if a:op ==# 'watch'
      return {'ok': v:true, 'payload': {'status': 'running', 'chunk': '', 'next_offset': 0, 'next_seq': 0, 'events': []}}
    endif
    throw 'unexpected op=' . a:op
  endfunction

  function! g:ToasTimeoutReportFrames(run_id, timeout_s) abort
    let g:toas_timeout_report_calls += 1
    return []
  endfunction

  let g:ToasTestLocalHostRequestFn = function('g:ToasTimeoutReportRequest')
  let g:ToasTestLocalHostSubscribeFn = function('g:ToasTimeoutReportFrames')

After:
  unlet! g:ToasTestLocalHostRequestFn
  unlet! g:ToasTestLocalHostSubscribeFn
  unlet! g:ToasTimeoutReportRequest
  unlet! g:ToasTimeoutReportFrames
  unlet! g:toas_timeout_report_calls
  unlet! g:toas_timeout_sid
  unlet! g:timeout_script_line
  unlet! g:toas_transport_mode

Execute (quiet subscribe publishes timeout observer before retry):
  let g:TimeoutEnsurePump = function(g:toas_timeout_sid . 'toas_watch_pump_ensure_state')
  let g:TimeoutReport = function(g:toas_timeout_sid . 'toas_watch_timeout_report')
  let g:TimeoutPump = call(g:TimeoutEnsurePump, ['rtimeoutreport1'])
  let g:TimeoutPump.last_status = 'running'
  let g:TimeoutPump.started_ms = 0
  let g:TimeoutPump.pending = []
  let g:TimeoutPump.ingress_lines = []
  call call(g:TimeoutReport, ['rtimeoutreport1', g:TimeoutPump, 2000, 2000, 'first_frame_timeout'])
  call call(g:TimeoutReport, ['rtimeoutreport1', g:TimeoutPump, 3000, 3000, 'first_frame_timeout'])
  let g:toas_timeout_health = execute('ToasWatchHealth rtimeoutreport1')
  Assert g:toas_timeout_health =~# 'timeout=1:subscribe_timeout'
  Assert g:toas_timeout_health =~# 'last_progress_ms=-1'
  Assert g:toas_timeout_health =~# 'longest_idle_ms=2000'
  Assert g:toas_timeout_health =~# 'resubscribe=0'
  Assert g:toas_timeout_health =~# 'recovery=0'
  redir => g:toas_timeout_debug
  silent ToasWatchDebug rtimeoutreport1
  redir END
  Assert len(get(eval(trim(g:toas_timeout_debug)), 'history', [])) == 1
