Before:
  set nocompatible
  let g:toas_step_nonblocking = 1
  let g:toas_workdir = getcwd()
  let g:toas_notice_enabled = 0
  let g:toas_transport_mode = 'rpc_local_backend'
  let g:_test_step_payloads = []

  function! g:ToasTestRpcStepCollector(op, payload, timeout_s) abort
    if a:op ==# 'step_async'
      call add(g:_test_step_payloads, deepcopy(a:payload))
      return {'payload': {'run_id': 'rtest' . len(g:_test_step_payloads), 'status': 'running', 'stream_policy': {}}}
    endif
    if a:op ==# 'watch'
      return {'payload': {'status': 'succeeded', 'next_offset': 10, 'next_seq': 1, 'events': [{'type': 'llm_delta', 'lane': 'llm_answer', 'phase': 'delta', 'seq': 1, 'payload': {'text': "## TOAS:ASSISTANT\n\nok\n"}}]}}
    endif
    throw 'unexpected op: ' . a:op
  endfunction

  let g:ToasTestRpcRequestFn = function('g:ToasTestRpcStepCollector')

After:
  unlet! g:ToasTestRpcRequestFn
  unlet! g:ToasTestRpcStepCollector
  unlet! g:_test_step_payloads
  unlet! g:toas_transport_mode

Execute (ToasStep default vs count arguments):
  let g:toas_test_session = tempname() . '.md'
  execute 'edit ' . fnameescape(g:toas_test_session)
  call setline(1, ['## TOAS:USER', '', 'test 1'])
  write
  call ToasStep()
  call ToasWatch('rtest1', '--follow')

  call ToasStep(10)
  call ToasWatch('rtest2', '--follow')

  :ToasStep 5
  call ToasWatch('rtest3', '--follow')

  :7ToasStep
  call ToasWatch('rtest4', '--follow')

Then:
  AssertEqual 4, len(g:_test_step_payloads)
  Assert !has_key(g:_test_step_payloads[0], 'max_turns'), 'default ToasStep should not have max_turns'
  AssertEqual 10, get(g:_test_step_payloads[1], 'max_turns', 0)
  AssertEqual 5, get(g:_test_step_payloads[2], 'max_turns', 0)
  AssertEqual 7, get(g:_test_step_payloads[3], 'max_turns', 0)

Execute (Normal mode 10\\s mapping sets max_turns=10):
  let g:toas_test_session = tempname() . '.md'
  execute 'edit ' . fnameescape(g:toas_test_session)
  call setline(1, ['## TOAS:USER', '', 'test 2'])
  write
  execute "normal 10\\s"
  call ToasWatch('rtest1', '--follow')

Then:
  AssertEqual 1, len(g:_test_step_payloads)
  AssertEqual 10, get(g:_test_step_payloads[0], 'max_turns', 0)

Execute (ToasStepHere default vs count arguments and mapping):
  let g:toas_test_session = tempname() . '.md'
  execute 'edit ' . fnameescape(g:toas_test_session)
  call setline(1, ['## TOAS:USER', '', 'line 1', 'line 2'])
  write
  call cursor(2, 1)
  call ToasStepHere()
  call ToasWatch('rtest1', '--follow')

  call cursor(2, 1)
  call ToasStepHere(3)
  call ToasWatch('rtest2', '--follow')

  call cursor(2, 1)
  :ToasStepHere 6
  call ToasWatch('rtest3', '--follow')

  call cursor(2, 1)
  :8ToasStepHere
  call ToasWatch('rtest4', '--follow')

  call cursor(2, 1)
  execute "normal 4\\S"
  call ToasWatch('rtest5', '--follow')

Then:
  AssertEqual 5, len(g:_test_step_payloads)
  Assert !has_key(g:_test_step_payloads[0], 'max_turns'), 'default ToasStepHere should not have max_turns'
  AssertEqual 3, get(g:_test_step_payloads[1], 'max_turns', 0)
  AssertEqual 6, get(g:_test_step_payloads[2], 'max_turns', 0)
  AssertEqual 8, get(g:_test_step_payloads[3], 'max_turns', 0)
  AssertEqual 4, get(g:_test_step_payloads[4], 'max_turns', 0)
